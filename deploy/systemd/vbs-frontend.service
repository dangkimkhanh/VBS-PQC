[Unit]
Description=VBS PQC frontend (Next.js)
After=network-online.target vbs-backend.service
Wants=network-online.target

[Service]
User=vbs
WorkingDirectory=/opt/vbs-pqc/app/frontend/.next/standalone
EnvironmentFile=/opt/vbs-pqc/app/frontend/.env.production
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
