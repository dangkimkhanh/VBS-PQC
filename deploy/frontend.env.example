# Copy to /opt/vbs-pqc/app/frontend/.env.production on the VPS.
# NEXT_PUBLIC_* values are built into the frontend: rebuild after changing them.
NEXT_PUBLIC_API_URL=https://example.com
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
# Signs the frontend session cookie:  openssl rand -hex 32
SESSION_SECRET=<openssl rand -hex 32>
