# Copy to /opt/vbs-pqc/app/backend/.env on the VPS and fill in every <...> value.
# Generate random values with:  openssl rand -hex 24   (PQC_MASTER_KEY: openssl rand -base64 32)

PORT=8080
APP_URL=https://example.com
# nginx runs on the same host; lets rate limits see the real client IP.
TRUSTED_PROXIES=127.0.0.1
SUPPORT_CONTACT=

# --- MongoDB (docker-compose.yml creates this root user on first start) ---
MONGO_INITDB_ROOT_USERNAME=vbs_pqc_db_admin
MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 24>
MONGODB_URI=mongodb://vbs_pqc_db_admin:<same password>@127.0.0.1:27017/?authSource=admin
DB_NAME=vbs_pqc

# --- MinIO (PDF storage; the bucket is created automatically) ---
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=vbs_pqc_minio
MINIO_SECRET_KEY=<openssl rand -hex 24>
MINIO_BUCKET=vbs-pqc
MINIO_USE_SSL=false

# --- Platform admin, created only on the very first start ---
ADMIN_EMAIL=<email quản trị hệ thống>
ADMIN_PASSWORD=<ít nhất 12 ký tự>

# --- Secrets ---
JWT_SECRET=<openssl rand -hex 32>
# Encrypts the universities' ML-DSA private keys. When moving an existing database,
# reuse the old value; a new value makes every existing signing key unusable.
PQC_MASTER_KEY=<openssl rand -base64 32>

# --- SMTP (OTP, activation, password reset, diploma notifications) ---
EMAIL_FROM=<gmail gửi thư>
EMAIL_PASSWORD=<app password của Gmail>
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# --- Hyperledger Fabric (certificates are copied to secrets/fabric/, not stored in git) ---
# The network runs on the same VPS, managed by ChainLaunch; the backend talks to a KMAUniverMSP peer.
FABRIC_MSP_ID=KMAUniverMSP
FABRIC_GATEWAY_ENDPOINT=127.0.0.1:7059
# Host name in the peer TLS certificate, when it differs from the endpoint host.
FABRIC_TLS_AUTHORITY_OVERRIDE=<host-in-peer-tls-certificate>
FABRIC_CHANNEL_NAME=ediploma-channel
FABRIC_CHAINCODE_NAME=ediploma-chaincode
FABRIC_CONTRACT_NAME=CertificateContract
FABRIC_TLS_CERT_PATH=secrets/fabric/peer-tls-ca.pem
FABRIC_TLS_CLIENT_CERT_PATH=secrets/fabric/peer-tls-client.crt
FABRIC_TLS_CLIENT_KEY_PATH=secrets/fabric/peer-tls-client.key
FABRIC_CLIENT_CERT_PATH=secrets/fabric/client-cert.pem
FABRIC_CLIENT_KEY_PATH=secrets/fabric/client-key.pem
FABRIC_STARTUP_CHECK=true
