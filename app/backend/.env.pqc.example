# Required only for ML-DSA private-key creation and signing.
# Generate a different value for each deployment. Never commit the real value.
# PowerShell:
#   $bytes = New-Object byte[] 32
#   [Security.Cryptography.RandomNumberGenerator]::Fill($bytes)
#   [Convert]::ToBase64String($bytes)
PQC_MASTER_KEY=<base64-encoded-32-random-bytes>

