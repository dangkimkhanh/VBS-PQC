# Accounts and authentication. Copy the keys you need into .env; never commit real values.

# Platform admin, created only on the very first run (when no admin account exists yet).
# Changing these later has no effect: use "Đổi mật khẩu" or "Quên mật khẩu" instead.
ADMIN_EMAIL=admin@example.edu.vn
ADMIN_PASSWORD=<at-least-12-characters>

# Secret used to sign login tokens. Use a long random value; rotating it logs everyone out.
JWT_SECRET=<long-random-secret>

# Public URL of the frontend. Used in activation, reset-password and diploma verification
# links sent by email, and allowed by CORS.
APP_URL=http://localhost:3000

# Comma-separated IPs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty when the backend is reached directly; otherwise rate limits could be bypassed.
TRUSTED_PROXIES=

# Optional support contact appended to activation emails, e.g. "hotro@example.edu.vn - 024 1234 5678".
SUPPORT_CONTACT=

# SMTP account used to send OTP, activation, reset-password and diploma notifications.
EMAIL_FROM=
EMAIL_PASSWORD=
EMAIL_HOST=
EMAIL_PORT=587
